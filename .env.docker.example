# Copy to .env.docker, then run Compose with --env-file .env.docker.
# Use single quotes around values containing $ to avoid Compose interpolation.
# Existing SQL Server, initialized using database/produccion/README.md.
# localhost inside the API container is NOT your host. For Docker Desktop use
# host.docker.internal or the reachable DNS/IP of your SQL Server.
SQL_CONNECTION_STRING='Server=host.docker.internal,1433;Database=ClubCamionerosCACC;User Id=cacc_api;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False;'
JWT_KEY=
INTEGRACION_CLAVE_DEPORTIVO=
JWT_ISSUER=CACC
JWT_AUDIENCE=CACC-Portales
PUBLIC_URL=http://localhost:8080
PUBLIC_SCHEME=http
DEPORTIVO_URL=
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Required for invitation and password recovery email in Production.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
