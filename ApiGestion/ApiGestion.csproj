<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3b4c14b5-969a-488f-bd23-b52f01dead76</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiGestion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaoLibrary\DaoLibrary.csproj" />
    <ProjectReference Include="..\ServiceLibrary\ServiceLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\database\migrations\*.sql">
      <LogicalName>ApiGestion.Database.Migrations.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- El escudo del club para los PDF (convertido del ícono del frontend): viaja dentro del ensamblado. -->
  <ItemGroup>
    <EmbeddedResource Include="Reports\Assets\logo-cacc.png">
      <LogicalName>ApiGestion.Reports.logo-cacc.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\frontend-cacc\public\cacc-email-header.jpg" Link="Assets\cacc-email-header.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

